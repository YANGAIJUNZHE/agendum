<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Agendum" android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="连接电脑，同步日程" android:textColor="@color/muted" android:textSize="15sp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="在电脑打开「设置 → 手机日程同步」，生成二维码后扫描连接。" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold" />
  <Button android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:backgroundTint="@color/primary" android:text="扫码连接电脑" android:textColor="@color/on_primary" android:textSize="17sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="二维码由你的电脑生成，配对凭据只可使用一次。" android:textColor="@color/muted" android:textSize="13sp" />
  <Button android:id="@+id/manual_toggle" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:backgroundTint="@color/card" android:text="手动填写地址" android:textColor="@color/primary" android:textSize="16sp" />
  <LinearLayout android:id="@+id/manual_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="填写电脑设置中的 HTTPS 同步地址。" android:textColor="@color/muted" android:textSize="14sp" />
   <EditText android:id="@+id/address" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:hint="例如 https://sync.example.com" android:inputType="textUri" android:singleLine="true" android:imeOptions="actionGo" />
   <Button android:id="@+id/open" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/primary" android:text="连接电脑并显示配对码" android:textColor="@color/on_primary" />
   <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/warning" android:textSize="14sp" />
   <TextView android:id="@+id/pair_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/primary" android:textSize="40sp" android:textStyle="bold" />
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="扫码仅用于连接你的电脑。遇到陌生页面，请取消并重新核对电脑上的二维码。" android:textColor="@color/muted" android:textSize="13sp" />
 </LinearLayout>
</ScrollView>
